{
  "name": "wixossreact",
  "private": true,
  "version": "0.537",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -b --noEmit",
    "build:effects": "tsx scripts/buildEffectsJson.ts && node scripts/fixLrigColorFilters.mjs && tsx scripts/fillSourceTextPayloads.ts",
    "verify": "tsx scripts/verifyEffects.ts",
    "smoke": "tsx scripts/smokeTest.ts",
    "golden": "tsx scripts/goldenTest.ts",
    "reports": "node scripts/fetchReports.mjs",
    "fuzz": "tsx scripts/selfPlayFuzz.ts",
    "selfplay": "tsx scripts/headlessSelfPlay.ts",
    "selfplay:ab": "tsx scripts/headlessSelfPlay.ts --jobs 8",
    "selfplay:scan": "tsx scripts/headlessSelfPlay.ts --diverge --jobs 8",
    "audit": "tsx scripts/behaviorAudit.ts",
    "audit:queue": "tsx scripts/behaviorAudit.ts --queue",
    "audit:html": "tsx scripts/behaviorAudit.ts --html",
    "census": "tsx scripts/vocabCensus.ts",
    "check:manual-fields": "tsx scripts/checkManualFieldLoss.ts",
    "census:clusters": "tsx scripts/vocabCensus.ts --clusters",
    "regen": "tsx scripts/decompileEffects.ts --sheets && node scripts/genReviewRepr.mjs && node scripts/groupSimilar.mjs --all && node scripts/groupBySentence.mjs --all",
    "gates": "node scripts/runGates.mjs",
    "verify:browser": "node scripts/verifyBrowser.mjs",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "preview": "vite preview",
    "census:timing": "tsx scripts/timingCensus.ts",
    "census:wiring": "tsx scripts/censusWiring.ts",
    "census:goldentypes": "tsx scripts/goldenTypeCoverage.ts",
    "census:cards": "node scripts/cardProgressCensus.mjs",
    "census:population": "node scripts/censusPopulation.mjs",
    "census:deadstate": "node scripts/censusDeadState.mjs",
    "census:stubs": "tsx scripts/censusStubs.ts",
    "census:enginetext": "tsx scripts/censusEngineText.ts",
    "census:costtext": "tsx scripts/censusCostText.ts",
    "census:orphanmanual": "tsx scripts/censusOrphanManual.ts",
    "census:payloadkeys": "tsx scripts/censusPayloadKeys.ts",
    "census:numberdrift": "node scripts/censusNumberDrift.mjs",
    "census:stublabel": "node scripts/censusStubLabel.mjs",
    "census:traceinv": "node --max-old-space-size=8192 scripts/censusTraceInvariants.mjs",
    "census:srcecho": "node scripts/censusSrcEcho.mjs",
    "census:play": "tsx scripts/censusPlay.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.99.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.105.4",
    "dotenv": "^17.4.2",
    "papaparse": "^5.5.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.12.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "sharp": "^0.34.5",
    "tsx": "^4.22.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
