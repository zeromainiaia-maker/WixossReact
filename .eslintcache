lue changes over time.\n\nC:\\Users\\zerom\\WixossReact\\src\\screens\\BattleScreen.tsx:460:42\n  458 |     if (inter.type === 'REARRANGE_SIGNI') {\n  459 |       if ((pe.respondPlayerId ?? pe.sourcePlayerId) !== CPU_PLAYER_ID) return;\n> 460 |       const timerRS = setTimeout(() => { handleRearrangeSigniConfirm(null); }, CPU_ACTION_DELAY);\n      |                                          ^^^^^^^^^^^^^^^^^^^^^^^^^^^ `handleRearrangeSigniConfirm` accessed before it is declared\n  461 |       return () => clearTimeout(timerRS);\n  462 |     }\n  463 |     // SELECT_VIRUS_ZONE / SELECT_ZONE / SELECT_SIGNI_ZONE は効果オーナーが応答する（CPUの効果ならCPUがゾーンを自動選択）\n\nC:\\Users\\zerom\\WixossReact\\src\\screens\\BattleScreen.tsx:4910:3\n  4908 |   // REARRANGE_SIGNI: シグニ配置し直しの確定。newArrangement[newZone]=instance id / ''=空き。\n  4909 |   // skip=null のときは現状維持（恒等配置）で解決し、continuation があれば実行する。\n> 4910 |   const handleRearrangeSigniConfirm = async (newArrangement: string[] | null) => {\n       |   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 4911 |     if (!bs?.pending_effect || loading) return;\n       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 4912 |     setLoading(true);\n       …\n       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 4946 |     }\n       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 4947 |   };\n       | ^^^^^ `handleRearrangeSigniConfirm` is declared here\n  4948 |\n  4949 |   // SELECT_VIRUS_ZONE: 【ウィルス】を置くシグニゾーンの選択（zoneIndex=nullで配置打ち切り）\n  4950 |   const handleSelectVirusZoneForEffect = async (zoneIndex: number | null) => {","Error: Cannot access variable before it is declared\n\n`handleSelectVirusZoneForEffect` is accessed before it is declared, which prevents the earlier access from updating when this value changes over time.\n\nC:\\Users\\zerom\\WixossReact\\src\\screens\\BattleScreen.tsx:478:11\n  476 |           : [0, 1, 2].find(zi => (tgtVirus[zi] ?? 0) === 0);\n  477 |         const timerVZ = setTimeou