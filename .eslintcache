ef value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\Users\\zerom\\WixossReact\\src\\screens\\BattleScreen.tsx:9672:3\n  9670 |     }\n  9671 |   };\n> 9672 |   cpuTurnRef.current = cpuTurnAction;\n       |   ^^^^^^^^^^^^^^^^^^ Cannot update ref during render\n  9673 |\n  9674 |   // GUARD_ALTERNATIVE_COST: エナゾーンから指定クラスのシグニをトラッシュしてガード\n  9675 |   const handleGuardWithEnergyAlternative = async () => {","no-control-regex","Unexpected control character(s) in regular expression: \\x00.","unexpected","React Hook useEffect has missing dependencies: 'appendBattleLogs', 'bs', and 'user.id'. Either include them or remove the dependency array.",["2578"],["2579"],["2580"],["2581"],["2582"],"React Hook useEffect has missing dependencies: 'bs.guest_state', 'bs.host_id', 'bs.host_state', 'cards', 'handleEffectInteraction', 'handleRearrangeSigniConfirm', 'handleSelectSigniZoneForEffect', 'handleSelectVirusZoneForEffect', and 'handleSelectZoneForEffect'. Either include them or remove the dependency array.",["2583"],["2584"],"React Hook useEffect has missing dependencies: 'bs', 'loading', and 'persist'. Either include them or remove the dependency array.",["2585"],["2586"],"React Hook useEffect has missing dependencies: 'bs' and 'persist'. Either include them or remove the dependency array.",["2587"],["2588"],"React Hook useEffect has a missing dependency: 'persist'. Either include it or remove the dependency array.",["2589"],["2590"],"React Hook useEffect has missing dependencies: 'bs.active_user_id', 'setStackOrderIds', and 'user'. Either include them or remove the dependency array.",["2591"],["2592"],"React Hook useEffect has missing dependencies: 'bs', 'isCpuBattle', 'loading', and 'user'. Either include them or remove the dependency array.",["2593"],["2594","2595"],"React Hook useEffect has missing dependencies: 'bs', 'loading', and 'user'. Either include them or remove the dependency array.",["2596"],["2597","2598"],["2599"],["2600","2601"],["2602"],["2603","2604"],["2605"],["2606","2607"],["2608"],["2609","2610"],"React Hook useEffect has missing dependencies: 'bs', 'checkAndFireOnAcceTriggersForOwner', 'loading', 'persist', 'setLoading', and 'user'. Either include them or remove the dependency array.",["2611"],["2612","2613"],"React Hook useEffect has missing dependencies: 'battleCardMap', 'bs', 'collectHandDiscardTriggers', 'effectsMap', 'loading', 'persist', 'setLoading', and 'user'. Either include them or remove the dependency array.",["2614"],["2615","2616"],"React Hook useEffect has missing dependencies: 'bs', 'collectSelfEventTriggers', 'isCpuBattle', 'loading', 'persist', 'setLoading', and 'user'. Either include them or remove the dependency array.",["2617"],["2618","2619"],"React Hook useEffect has missing dependencies: 'bs', 'collectZoneMovedTriggers', 'isCpuBattle', 'loading', 'persist', 'setLoading', and 'user'. Either include them or remove the dependency array.",["2620"],["2621","2622"],"React Hook useEffect has missing dependencies: 'bs', 'collectDriveBecameTriggers', 'isCpuBattle', 'loading', 'persist', 'setLoading', and 'user'. Either include them or remove the dependency array.",["2623"],["2624","2625"],"React Hook useEffect has missing dependencies: 'bs', 'collectBeatBecameTriggers', 'isCpuBattle', 'loading', 'persist', 'setLoading', and 'user'. Either include them or remove the dependency array.",["2626"],["2627","2628"],"React Hook useEffect has missing dependencies: 'battleCardMap', 'effectsMap', 'persist', 'setLoading', and 'user'. Either include them or remove the dependency array.",["2629"],["2630","2631"],["2632"],["2633","2634"],"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Users\\zerom\\WixossReact\\src\\screens\\DeckListScreen.tsx:119:27\n  117 |     const added = decks.some(d => !localIds.has(d.id));\n  118 |     const removed = localDecks.some(d => !parentIds.has(d.id));\n> 119 |     if (added || removed) setLocalDecks(decks);\n      |                           ^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  120 |   }, [decks]);\n  121 |\n  122 |   return (","React Hook useEffect has a missing dependency: 'localDecks'. Either include it or remove the dependency array.",["2635"],"React Hook useEffect has missing dependencies: 'onBattleStart', 'room', and 'selectedDeckId'. Either include them or remove the dependency array. If 'onBattleStart' changes too often, find the parent component that defines it and wrap that definition in useCallback.",["2636"],{"messageId":"2637","fix":"2638","desc":"2639"},{"messageId":"2640","fix":"2641","desc":"2642"},{"kind":"2643","justification":"2644"},{"messageId":"2637","fix":"2645","desc":"2639"},{"messageId":"2640","fix":"2646","desc":"2642"},{"kind":"2643","justification":"2644"},{"messageId":"2637","fix":"2647","desc":"2639"},{"messageId":"2640","fix":"2648","desc":"2642"},{"kind":"2643","justification":"2644"},{"messageId":"2637","fix":"2649","desc":"2639"},{"messageId":"2640","fix":"2650","desc":"2642"},{"kind":"2643","justification":"2644"},{"messageId":"2637","fix":"2651","desc":"2639"},{"messageId":"2640","fix":"2652","desc":"2642"},{"kind":"2643","justification":"2644"},{"messageId":"2637","fix":"2653","desc":"2639"},{"messageId":"2640","fix":"2654","desc":"2642"},