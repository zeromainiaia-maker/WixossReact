 handleSelectSigniZoneForEffect = async (zoneIndex: number) => {","Error: Cannot access variable before it is declared\n\n`handleEffectInteraction` is accessed before it is declared, which prevents the earlier access from updating when this value changes over time.\n\nC:\\Users\\zerom\\WixossReact\\src\\screens\\BattleScreen.tsx:540:7\n  538 |         selected = [...inter.cards];\n  539 |       }\n> 540 |       handleEffectInteraction(selected);\n      |       ^^^^^^^^^^^^^^^^^^^^^^^ `handleEffectInteraction` accessed before it is declared\n  541 |     }, CPU_ACTION_DELAY);\n  542 |     return () => clearTimeout(timer);\n  543 |   // eslint-disable-next-line react-hooks/exhaustive-deps\n\nC:\\Users\\zerom\\WixossReact\\src\\screens\\BattleScreen.tsx:4527:3\n  4525 |   // --- pending_effect インタラクション解決 ---\n  4526 |\n> 4527 |   const handleEffectInteraction = async (selectedOrChoiceId: string[]) => {\n       |   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 4528 |     if (!bs?.pending_effect || loading) return;\n       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 4529 |     setLoading(true);\n       …\n       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 4784 |     }\n       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 4785 |   };\n       | ^^^^^ `handleEffectInteraction` is declared here\n  4786 |\n  4787 |   // SELECT_ZONE: 効果でデッキトップを場に出す際のゾーン選択\n  4788 |   const handleSelectZoneForEffect = async (zoneIndex: number) => {","React Hook useEffect has missing dependencies: 'setEffectSelectedNums', 'setLookReorderBottom', 'setLookReorderOrder', and 'setLookReorderTrash'. Either include them or remove the dependency array.",["2562"],"Unused eslint-disable directive (no problems were reported from 'react-hooks/exhaustive-deps').",{"range":"2563","text":"2564"},{"range":"2565","text":"2564"},{"range":"2566","text":"2564"},{"range":"2567","text":"2564"},{"range":"2568","text":"2564"},{"range":"2569","text":"2564"},{"range":"2570","text":"2564"},{"range":"2571","text":"2564"},{"range":"2572","text":"2564"},{"range":"2573","text":"2564"},{"range":"2574","text":"2564"},{"range":"2575","text":"2564"},{"range":"2576","text":"2564"},{"range":"2577","text":"2564"},"react-hooks/refs","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\Users\\zerom\\WixossReact\\src\\screens\\BattleScreen.tsx:1759:3\n  1757 |     }\n  1758 |   };\n> 1759 |   cpuSetupRef.current = cpuSetupAction;\n       |   ^^^^^^^^^^^^^^^^^^^ Cannot update ref during render\n  1760 |\n  1761 |   // ══════════════════════════════════════════\n  1762 |   // SETUP フェイズ","react-hooks/rules-of-hooks","React Hook \"useHost\" may be executed more than once. Possibly because it is called in a loop. React Hooks must be called in the exact same order in every component render.","React Hook \"useHost\" is called in function \"collectBoardDiffTriggers\" that is neither a React function component nor a custom React Hook function. React component names must start with an uppercase letter. React Hook names must start with the word \"use\".","React Hook \"useGuest\" may be executed more than once. Possibly because it is called in a loop. React Hooks must be called in the exact same order in every component render.","React Hook \"useGuest\" is called in function \"collectBoardDiffTriggers\" that is neither a React function component nor a custom React Hook function. React component names must start with an uppercase letter. React Hook names must start with the word \"use\".","React Hook \"useSU\" may be executed more than once. Possibly because it is called in a loop. React Hooks must be called in the exact same order in every component render.","R