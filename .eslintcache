) === 0);\n  473 |         const timerVZ = setTimeout(() => {\n> 474 |           handleSelectVirusZoneForEffect(zone ?? null);\n      |           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ `handleSelectVirusZoneForEffect` accessed before it is declared\n  475 |         }, CPU_ACTION_DELAY);\n  476 |         return () => clearTimeout(timerVZ);\n  477 |       }\n\nC:\\Users\\zerom\\WixossReact\\src\\screens\\BattleScreen.tsx:4833:3\n  4831 |\n  4832 |   // SELECT_VIRUS_ZONE: 【ウィルス】を置くシグニゾーンの選択（zoneIndex=nullで配置打ち切り）\n> 4833 |   const handleSelectVirusZoneForEffect = async (zoneIndex: number | null) => {\n       |   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 4834 |     if (!bs?.pending_effect || loading) return;\n       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 4835 |     setLoading(true);\n       …\n       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 4873 |     }\n       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 4874 |   };\n       | ^^^^^ `handleSelectVirusZoneForEffect` is declared here\n  4875 |\n  4876 |   /**\n  4877 |    * フィールド上の全シグニから、指定イベントに反応する AUTO 効果を収集して StackEntry[] を返す。","Error: Cannot access variable before it is declared\n\n`handleSelectSigniZoneForEffect` is accessed before it is declared, which prevents the earlier access from updating when this value changes over time.\n\nC:\\Users\\zerom\\WixossReact\\src\\screens\\BattleScreen.tsx:482:11\n  480 |         if (emptyZoneSZ === undefined) return;\n  481 |         const timerSSZ = setTimeout(() => {\n> 482 |           handleSelectSigniZoneForEffect(emptyZoneSZ);\n      |           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ `handleSelectSigniZoneForEffect` accessed before it is declared\n  483 |         }, CPU_ACTION_DELAY);\n  484 |         return () => clearTimeout(timerSSZ);\n  485 |       }\n\nC:\\Users\\zerom\\WixossReact\\src\\screens\\BattleScreen.tsx:4731:3\n  4729 |\n  4730 |   // SELECT_SIGNI_ZONE: トラッシュ/エナ/手札などから場に出す際のゾーン選択\n> 4731 |   const handleS