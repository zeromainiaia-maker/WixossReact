solvePendingSigniBattle;\n  8796 |   resolvePendingLrigAttackRef.current      = resolvePendingLrigAttack;\n  8797 |","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\Users\\zerom\\WixossReact\\src\\screens\\BattleScreen.tsx:8795:3\n  8793 |   checkPowerZeroBanishRef.current          = checkAndBanishPowerZero;\n  8794 |   checkContMutationsRef.current            = checkAndApplyContMutations;\n> 8795 |   resolvePendingSigniBattleRef.current     = resolvePendingSigniBattle;\n       |   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ Cannot update ref during render\n  8796 |   resolvePendingLrigAttackRef.current      = resolvePendingLrigAttack;\n  8797 |\n  8798 |   // ══════════════════════════════════════════","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\Users\\zerom\\WixossReact\\src\\screens\\BattleScreen.tsx:8796:3\n  8794 |   checkContMutationsRef.current            = checkAndApplyContMutations;\n  8795 |   resolvePendingSigniBattleRef.current     = resolvePendingSigniBattle;\n> 8796 |   resolvePendingLrigAttackRef.current      = resolvePendingLrigAttack;\n       |   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ Cannot update ref during render\n  8797 |\n  8798 |   // ══════════════════════════════════════════\n  8799 |   // CPU AI ロジック（ターン行動）","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\Users\\zerom\\WixossReact\\src\\screens\\BattleScreen.tsx:9471:3\n  9469 |     }\n  9470 |   };\n> 9471 |   cpuTurnRef.current = cpuTurnAction;\n       |   ^^^^^^^^^^^^^^^^^^ Cannot update ref during render\n  9472 |\n  9473 |   // GUARD_ALTERNATIVE_COST: エナゾーンから指定クラスのシグニをトラッシュしてガード\n  9474 |   const handleGuardWithEnergyAlternative = async () => {","no-control-regex","Unexpected control character(s) in regular expression: \\x00.","unexpected","React Hook useEffect has missing dependencies: 'appendBattleLogs', 'bs', and 'user.id'. Either include them or remove the dependency array.",["2585"],["2586"],["2587"],["2588"],["2589"],"React Hook useEffect has missing dependencies: 'bs.guest_state', 'bs.host_id', 'bs.host_state', 'cards', 'handleEffectInteraction', 'handleRearrangeSigniConfirm', 'handleSelectSigniZoneForEffect', 'handleSelectVirusZoneForEffect', and 'handleSelectZoneForEffect'. Either include them or remove the dependency array.",["2590"],["2591"],"React Hook useEffect has missing dependencies: 'bs', 'loading', and 'persist'. Either include them or remove the dependency array.",["2592"],["2593"],"React Hook useEffect has missing dependencies: 'bs' and 'persist'. Either include them or remove the dependency array.",["2594"],["2595"],"React Hook useEffect has a missing dependency: 'persist'. Either include it or remove the dependency array.",["2596"],["2597"],"React Hook useEffect has missing dependencies: 'bs.active_user_id', 'setStackOrderIds', and 'user'. Either include them or remove the dependency array.",["2598"],["2599"],"React Hook useEffect has missing dependencies: 'bs', 'isCpuBattle', 'loading', and 'user'. Either include them or remove the dependency array.",["2600"],["2601","2602"],"React Hook useEffect has missing dependencies: 'bs', 'loading', and 'user'. Either include them or remove the dependency array.",["2603"],["2604","2605"],["2606"],["2607","2608"],["2609"],["2610","2611"],["2612"],["2613","2614"],["2615"],["2616","2617"],"React Hook useEffect has missing dependencies: 'bs', 'checkAndFireOnAcceTriggersForOwner', 'loading', 'persist', 'setLoading', and 'user'. Either include them or remove the dependency array.",["2618"],["2619","2620"],"React Hook useEffect has missing dependencies: 'battleCardMap', 'bs', 'collectHandDiscardTriggers', 'effectsMap', 'loading', 'persist', 'setLoading', and 'user'. Either include them or remove the dependency array.",["2621"],["2622","2623"],"React Hook useEffect has missing dependencies: 'bs', 'collectSelfEventTriggers', 'isCpuBattle', 'loading', 'persist', 'setLoading', and 'user'. Either include them or remove the dependency array.",["2624"],["2625","2626"],"React Hook useEffect has missing dependencies: 'bs', 'collectZoneMovedTriggers', 'isCpuBattle', 'loading', 'persist', 'setLoading', and 'user'. Either include them or remove the dependency array.",["2627"],["2628","2629"],"React Hook useEffect has missing dependencies: 'bs', 'collectDriveBecameTriggers', 'isCpuBattle', 'loading', 'persist', 'setLoading', and 'user'. Either include them or remove the dependency array.",["2630"],["2631","2632"],"React Hook useEffect has missing dependencies: 'bs', 'collectBeatBecameTriggers', 'isCpuBattle', 'loading', 'persist', 'setLoading', and 'user'. Either include them or remove the dependency array.",["2633"],["2634","2635"],"React Hook useEffect has missing dependencies: 'battleCardMap', 'effectsMap', 'persist', 'setLoading', and 'user'. Either include them or remove the dependency array.",["2636"],["2637","2638"],["2639"],["2640","2641"],"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Users\\zerom\\WixossReact\\src\\screens\\DeckListScreen.tsx:119:27\n  117 |     const added = decks.some(d => !localIds.has(d.id));\n  118 |     const removed = localDecks.some(d => !parentIds.has(d.id));\n> 119 |     if (added || removed) setLocalDecks(decks);\n      |                           ^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  120 |   }, [decks]);\n  121 |\n  122 |   return (","React Hook useEffect has a missing dependency: 'localDecks'. Either include it or remove the dependency array.",["2642"],"React Hook useEffect has missing dependencies: 'onBattleStart', 'room', and 'selectedDeckId'. Either include them or remove the dependency array. If 'onBattleStart' changes too often, find the parent component that defines it and wrap that definition in useCallback.",["2643"],{"messageId":"2644","fix":"2645","desc":"2646"},{"messageId":"2647","fix":"2648","desc":"2649"},{"kind":"2650","justification":"2651"},{"messageId":"2644","fix":"2652","desc":"2646"},{"messageId":"2647","fix":"2653","desc":"2649"},{"kind":"2650","justification":"2651"},{"messageId":"2644","fix":"2654","desc":"2646"},{"messageId":"2647","fix":"2655","desc":"2649"},{"kind":"2650","justification":"2651"},{"messageId":"2644","fix":"2656","desc":"2646"},{"messageId":"2647","fix":"2657","desc":"2649"},{"kind":"2650","justification":"2651"},{"messageId":"2644","fix":"2658","desc":"2646"},{"messageId":"2647","fix":"2659","desc":"2649"},{"kind":"2650","justification":"2651"},{"messageId":"2644","fix":"2660","desc":"264